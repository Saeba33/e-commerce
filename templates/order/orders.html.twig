{% extends 'base.html.twig' %}

{% block title %}Liste des commandes
{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-6">
		<div class="content-container">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
				<div>
					<h1 class="text-3xl font-bold text-gray-800 mb-2">Gestion des commandes</h1>
					<p class="text-gray-600">Historique et gestion des commandes</p>
				</div>
			</div>

			{# Boutons de filtres #}
			<div class="mb-6">
				<div class="flex flex-wrap gap-2 mb-4">
					<a href="{{ path('app_orders_show', {'type': 'all'}) }}" class="btn btn-sm {{ currentFilter == 'all' ? 'btn-primary' : 'btn-outline' }}">
						Toutes
					</a>
					<a href="{{ path('app_orders_show', {'type': 'delivered'}) }}" class="btn btn-sm {{ currentFilter == 'delivered' ? 'btn-primary' : 'btn-outline' }}">
						Livrées
					</a>
					<a href="{{ path('app_orders_show', {'type': 'not-delivered'}) }}" class="btn btn-sm {{ currentFilter == 'not-delivered' ? 'btn-primary' : 'btn-outline' }}">
						Non livrées
					</a>
					<a href="{{ path('app_orders_show', {'type': 'pending-payment'}) }}" class="btn btn-sm {{ currentFilter == 'pending-payment' ? 'btn-primary' : 'btn-outline' }}">
						Abandonnées / Non payées
					</a>
					<a href="{{ path('app_orders_show', {'type': 'pickup'}) }}" class="btn btn-sm {{ currentFilter == 'pickup' ? 'btn-primary' : 'btn-outline' }}">
						Retrait en magasin
					</a>
					<a href="{{ path('app_orders_show', {'type': 'delivery'}) }}" class="btn btn-sm {{ currentFilter == 'delivery' ? 'btn-primary' : 'btn-outline' }}">
						Livraison à domicile
					</a>
				</div>
			</div>

			{% include 'layouts/_flash_message.html.twig' %}

			<div class="card bg-white">
				<div class="card-body p-0">
					{% if orders|length > 0 %}
						<div class="hidden xl:block overflow-x-auto">
							<table class="table table-zebra w-full border-2 border-base-300">
								<thead class="bg-gray-300">
									<tr>
										<th class="text-center py-4 px-2 border-r border-base-300">Numéro</th>
										<th class="text-left py-4 px-2 border-r border-base-300">Prénom</th>
										<th class="text-left py-4 px-2 border-r border-base-300">Nom</th>
										<th class="text-center py-4 px-2 border-r border-base-300">Téléphone</th>
										<th class="text-left py-4 px-2 border-r border-base-300">Adresse</th>
										<th class="text-left py-4 px-2 border-r border-base-300">Ville</th>
										<th class="text-center py-4 px-2 border-r border-base-300">Retrait en magasin</th>
										<th class="text-center py-4 px-2 border-r border-base-300">Montant</th>
										<th class="text-center py-4 px-2 border-r border-base-300">Statut</th>
										<th class="text-center py-4 px-2">Actions</th>
									</tr>
								</thead>
								<tbody>
									{% for order in orders %}

										<tr class="hover:bg-base-50 transition-colors duration-200">
											<td class="text-center py-4 px-2 sm:px-6 border-r-2 border-base-300">{{ order.id }}</td>
											<td class="py-4 px-2 border-r-2 border-base-300">{{ order.firstname }}</td>
											<td class="py-4 px-2 border-r-2 border-base-300">{{ order.lastname }}</td>
											<td class="text-center py-4 px-2 border-r-2 border-base-300">{{ order.phone }}</td>
											<td class="py-4 px-2 border-r-2 border-base-300">{{ order.address }}</td>
											<td class="py-4 px-2 border-r-2 border-base-300">{{ order.city ?: '' }}</td>
											<td class="text-center py-4 px-2 border-r-2 border-base-300">
												{% if order.isPickup %}
													<span class="text-sm text-gray-600">Oui</span>
												{% else %}
													<span class="text-sm text-gray-600">Non</span>
												{% endif %}
											</td>
											<td class="text-center py-4 px-2 border-r-2 border-base-300">{{ order.totalPrice }}
												€</td>
											<td class="text-center py-4 px-2 border-r-2 border-base-300">

												{% if order.isDelivered == true %}
													<span class="text-sm text-gray-600">Commande livrée</span>
												{% else %}
													<span class="text-sm text-gray-600">Commande non livrée</span>
												{% endif %}
											</td>

											<td class="flex flex-col items-center justify-center gap-2 py-4 px-2">
												<div class="dropdown dropdown-center relative">
													<div tabindex="0" role="button" class="btn btn-primary">
														<ion-icon name="ellipsis-vertical-outline"></ion-icon>
													</div>

													<ul tabindex="0" class="dropdown-content absolute menu bg-base-100 rounded-box w-max z-1 p-2 shadow-sm gap-3">
														<li>
															<a href="{{ path('app_order_show', {'id': order.id}) }}" class="">
																<ion-icon name="eye-outline"></ion-icon>
																<span class="hidden xl:inline">Voir details</span>
															</a>
														</li>

														{% if order.isDelivered == false %}
															<li>
																<a href="{{ path('app_orders_is_completed_update', {'id':order.id}) }}" class="">
																	<ion-icon name="checkmark-done-outline"></ion-icon>
																	{# <ion-icon name="checkmark-circle-outline"></ion-icon>
																	<ion-icon name="thumbs-up-outline"></ion-icon> #}
																	<span class="hidden xl:inline">Marquer  livrée</span>
																</a>
															</li>
														{% endif %}

														<li>
															<a onclick="return confirm('Attention cette action est irréverssible. Êtes-vous sûr de vouloir supprimer la commande numéro : {{ order.id }} ?')" href="{{ path('app_order_delete', {'id': order.id}) }}" class="">
																<ion-icon name="trash-outline"></ion-icon>
																Supprimer
															</a>
														</li>
														<li>
															<a href="{{ path('app_bill', {'id': order.id}) }}" class="">
																<ion-icon name="receipt-outline"></ion-icon>Voir la facture

															</a>
														</li>
													</ul>
												</div>


											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						<div class="xl:hidden p-4 space-y-4">
							{% for order in orders %}
								<div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4">
									<div class="flex justify-between items-start mb-3">
										<div class="flex-1">
											<p class="text-sm text-gray-600 mb-1">Commande #:
												{{ order.id }}</p>
											<h3 class="font-semibold text-lg text-gray-900 mb-1">{{ order.firstname }}
												{{ order.lastname }}</h3>
											<p class="text-sm text-gray-700 mb-1">{{ order.address }}
												{{ order.city }}
											</p>
											<div class="mb-2">
												<span class="text-sm text-gray-600">Montant:
												</span>
												<span class="font-semibold">{{ order.totalPrice }}
													€</span>
											</div>
										</div>
									</div>

									<div class="flex flex-wrap gap-2 mt-2">
										<a href="{{ path('app_order_show', {'id': order.id}) }}" class="custom-btn-with-logo edit-btn flex-1">
											<ion-icon name="eye-outline"></ion-icon>
											<span>Voir</span>
										</a>
									</div>
								</div>
							{% endfor %}
						</div>

						{{ knp_pagination_render(orders, 'layouts/_pagination.html.twig') }}
					{% else %}
						<div class="text-center py-16">
							<ion-icon name="cube-outline" class="text-6xl text-gray-400 mb-4"></ion-icon>
							<h3 class="text-xl font-semibold text-gray-600 mb-2">Aucune commande</h3>
							<p class="text-gray-500">Aucune commande n'a été passée pour le moment.</p>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
