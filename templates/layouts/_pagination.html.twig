{% if pageCount > 1 %}
	<nav aria-label="Pagination Navigation" class="mt-20">
		<div
			class="flex justify-center items-center -space-x-px h-10">

			{# Bouton précédent #}
			{% set prevClasses = 'flex items-center justify-center px-2 h-10 leading-tight border border-gray-300 transition-all duration-200' ~
			(previous is defined ? 'text-gray-500 bg-white rounded-s-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white m-px' : 
			'text-gray-400 bg-white rounded-s-lg cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-500 m-px') 
		%}

			{% if previous is defined %}
				<a href="{{ path(route, query|merge({(pageParameterName):previous})) }}" class="{{ prevClasses }}">
					<ion-icon name="chevron-back-outline"></ion-icon>
				</a>
			{% else %}
				<button disabled class="{{ prevClasses }}">
					<ion-icon name="chevron-back-outline"></ion-icon>
				</button>
			{% endif %}

			{# Pages #}
			{% for page in pagesInRange %}
				{% if page == current %}
					<button class="z-10 flex items-center justify-center px-4 h-10 leading-tight text-white bg-gray-700 border-2 border-gray-700" aria-current="page">
						{{ page }}
					</button>
				{% else %}
					<a href="{{ path(route, query|merge({(pageParameterName):page})) }}" class="flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
						{{ page }}
					</a>
				{% endif %}
			{% endfor %}

			{# Bouton suivant #}
			{% set nextClasses = 'flex items-center justify-center px-2 h-10 leading-tight border border-gray-300 ' ~
			(next is defined ? 'text-gray-500 bg-white rounded-e-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white m-px' : 
			'text-gray-400 bg-white rounded-e-lg cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-500 m-px') 
		%}

			{% if next is defined %}
				<a href="{{ path(route, query|merge({(pageParameterName):next})) }}" class="{{ nextClasses }}">
					<ion-icon name="chevron-forward-outline"></ion-icon>
				</a>
			{% else %}
				<button disabled class="{{ nextClasses }}">
					<ion-icon name="chevron-forward-outline"></ion-icon>
				</button>
			{% endif %}

		</div>
	</nav>
{% endif %}

