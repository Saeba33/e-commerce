{% if pageCount > 1 %}
	<nav aria-label="Pagination Navigation" class="mt-20">
		<div
			class="flex justify-center items-center h-10 space-x-1">

			{# Bouton précédent #}
			{% if previous is defined %}
				<a href="{{ path(route, query|merge({(pageParameterName): previous})) }}" class="flex items-center justify-center w-10 h-10 rounded-full text-gray-600 hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-500 transition">
					<ion-icon name="chevron-back-outline"></ion-icon>
				</a>
			{% else %}
				<button disabled class="flex items-center justify-center w-10 h-10 rounded-full text-gray-300 cursor-not-allowed">
					<ion-icon name="chevron-back-outline"></ion-icon>
				</button>
			{% endif %}

			{# Pages #}
			<div class="flex items-center overflow-hidden">
				{% if pagesInRange[0] > 1 %}
					<a href="{{ path(route, query|merge({(pageParameterName): 1})) }}" class="px-4 h-10 flex items-center justify-center text-gray-600 hover:bg-slate-50 hover:text-slate-600">
						1
					</a>
					<span class="px-3 text-gray-400">…</span>
				{% endif %}

				{% for page in pagesInRange %}
					{% if page == current %}
						<button aria-current="page" class="px-2 mx-2 h-10 flex items-center justify-center  text-3xl text-slate-600 font-bold border-b">
							{{ page }}
						</button>
					{% else %}
						<a href="{{ path(route, query|merge({(pageParameterName): page})) }}" class="px-4 h-10 flex items-center justify-center text-gray-600 hover:bg-slate-50 hover:text-slate-600">
							{{ page }}
						</a>
					{% endif %}
				{% endfor %}

				{% if pagesInRange[pagesInRange|length - 1] < pageCount %}
					<span class="px-3 text-gray-400">…</span>
					<a href="{{ path(route, query|merge({(pageParameterName): pageCount})) }}" class="px-4 h-10 flex items-center justify-center text-gray-600 hover:bg-slate-50 hover:text-slate-600">
						{{ pageCount }}
					</a>
				{% endif %}
			</div>

			{# Bouton suivant #}
			{% if next is defined %}
				<a href="{{ path(route, query|merge({(pageParameterName): next})) }}" class="flex items-center justify-center w-10 h-10 rounded-full text-gray-600 hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-500 transition">
					<ion-icon name="chevron-forward-outline"></ion-icon>
				</a>
			{% else %}
				<button disabled class="flex items-center justify-center w-10 h-10 rounded-full text-gray-300 cursor-not-allowed">
					<ion-icon name="chevron-forward-outline"></ion-icon>
				</button>
			{% endif %}

		</div>
	</nav>
{% endif %}

