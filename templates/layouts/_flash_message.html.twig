{% for type, messages in app.flashes(['info','success','warning','error','danger']) %}
	{% for message in messages %}
		<script>
			document.addEventListener('DOMContentLoaded', function () {
if (window.toasts) {
{% if type == 'danger' %}
window.toasts.error('{{ message|e('js') }}');
{% else %}
window.toasts.{{ type }}('{{ message|e('js') }}');{% endif %}
}
});
		</script>
	{% endfor %}
{% endfor %}
