{% extends 'base.html.twig' %}

{% block title %}
	Historique du stock
{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-6">
		<div
			class="content-container">
			{# Header and back btn #}
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
				<div>
					<h1 class="text-3xl font-bold text-gray-800 mb-2">Historique du stock</h1>
					<p class="text-gray-600">Historique des mouvements de stock pour le produit
						<span class="ml-2 font-semibold text-xl text-blue-800">{{ product.name }}</span>
					</p>
				</div>
				<a href="{{ path('app_product') }}" class="custom-btn-with-logo back-btn">
					<ion-icon name="return-down-back-outline"></ion-icon>
					Retour
				</a>
			</div>

			{# Messages flash #}
			{% include 'layouts/_flash_message.html.twig' %}

			{# Table #}
			<div class="card bg-white">
				<div class="card-body p-0">
					<div class="overflow-x-auto">
						<table class="table table-zebra w-full border-2 border-base-300">
							<thead class="bg-gray-300">
								<tr>
									<th class="text-center py-4 px-2 sm:px-6 border-2 border-base-300">ID</th>
									<th class="text-center py-4 px-2 sm:px-6 border-2 border-base-300">Quantité modifiée</th>
									<th class="text-left py-4 px-2 sm:px-6 border-2 border-base-300">Origine</th>
									<th class="text-center py-4 px-2 sm:px-6 border-2 border-base-300">Date d'ajout</th>
								</tr>
							</thead>
							<tbody>
								{% for productHistory in productsAdded %}
									<tr class="hover:bg-base-50 transition-colors duration-200">
										<td class="text-center py-4 px-2 sm:px-6 border-r-2 border-base-300">{{ productHistory.id }}</td>

										{% set qtyClass = productHistory.quantity > 0 ? 'text-green-600' : 'text-red-600' %}
										<td class="text-center py-4 px-2 sm:px-6 border-r-2 border-base-300 font-medium {{ qtyClass }}">
											{% if productHistory.quantity > 0 %}+
											{% endif %}
											{{ productHistory.quantity }}
										</td>
										<td class="text-left py-4 px-2 sm:px-6 border-r-2 border-base-300">
											{% if productHistory.origin starts with 'order_' %}
												<span>Commande #{{ productHistory.origin|slice(6) }}</span>
											{% elseif productHistory.origin == 'product_creation' %}
												<span>Création de la fiche produit</span>
											{% elseif productHistory.origin == 'direct_edit' %}
												<span>Édition de la fiche produit</span>
											{% elseif productHistory.origin == 'manual_add' %}
												<span>Ajout du stock</span>
											{% else %}
												<span>{{ productHistory.origin }}</span>
											{% endif %}
										</td>
										<td class="text-center py-4 px-2 sm:px-6">{{ productHistory.createdAt|date('d/m/Y H:i') }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
