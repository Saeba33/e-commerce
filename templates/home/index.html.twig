{% extends 'base.html.twig' %}

{% block title %}
	Accueil
{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-12">
		<div class="text-center mb-12">
			<h1 class="text-4xl font-bold mb-8 text-gray-800">Notre Collection</h1>
			<p class="text-gray-600 max-w-2xl mx-auto">Découvrez notre sélection de produits</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
			{% for product in products %}
				{% set cartQuantity = cart[product.id] ?? 0 %}
				{% set availableStock = product.stock - cartQuantity %}
				<div class="group bg-white hover:bg-gray-50 transition-all duration-200 p-5 rounded-lg border border-gray-100 hover:border-gray-200 shadow-lg grid grid-rows-[auto_1fr_auto_auto_auto] min-h-[400px] hover:translate-y-[-2px]" data-product-id="{{ product.id }}" data-stock="{{ product.stock }}" data-cart-quantity="{{ cartQuantity }}" data-available-stock="{{ availableStock }}">
					<div class="relative aspect-square mb-3 overflow-hidden rounded-lg bg-gray-50">
						{% if product.image %}
							<img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" class="w-full h-full object-cover transition-transform duration-200">
						{% else %}
							<div class="w-full h-full flex flex-col items-center justify-center bg-gray-100">
								<ion-icon name="image-outline" class="text-4xl text-gray-300 mb-2"></ion-icon>
								<span class="text-xs text-gray-400 font-medium">Aucune image disponible</span>
							</div>
						{% endif %}
					</div>

					<div class="flex items-center justify-between gap-3 mb-2">
						<a href="{{ path('app_home_product_show', {'id': product.id})}}" class="font-medium text-gray-900 hover:text-blue-600 transition-colors flex-1 leading-tight">
							{{ product.name }}
						</a>
						<span class="text-lg font-bold text-gray-900 flex-shrink-0">{{ product.price }}€</span>
					</div>

					<div class="h-10 mb-4">
						{% if product.description %}
							<p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">
								{{ product.description | slice(0,50) }}
								{% if product.description|length > 50 %}...
								{% endif %}
							</p>
						{% endif %}
					</div>

					<div class="flex-1"></div>

					<div class="flex items-center justify-center mb-2">
						<button class="btn-minus px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-l text-gray-700 transition-colors" {% if 1 >= 1 %} disabled {% endif %}>-</button>
						<span class="quantity-display px-4 py-1 bg-gray-100 text-center min-w-[3rem]">1</span>
						<button class="btn-plus px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-r text-gray-700 transition-colors" {% if 1 >= availableStock %} disabled {% endif %}>+</button>
					</div>

					{% if cartQuantity > 0 %}
						<div class="text-xs text-blue-600 text-center mb-1">
							{{ cartQuantity }}
							déjà dans le panier
						</div>
					{% endif %}

					{% if availableStock > 0 %}
						<a href="#" class="add-to-cart-btn w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded transition-colors flex items-center justify-center" data-product-id="{{ product.id }}">
							<ion-icon name="cart-outline" class="text-base mr-2"></ion-icon>
							Ajouter au panier
						</a>
					{% else %}
						<button disabled class="w-full bg-gray-300 text-gray-500 font-medium py-2 px-4 rounded cursor-not-allowed flex items-center justify-center">
							<ion-icon name="close-outline" class="text-base mr-2"></ion-icon>
							Stock épuisé
						</button>
					{% endif %}
				</div>
			{% endfor %}
		</div>

		{{ knp_pagination_render(products, 'layouts/_pagination.html.twig') }}
	</div>

	{# Inclusion du gestionnaire de quantité #}
	 <script src="{{ asset('js/quantity-manager.js') }}"></script>
{% endblock %}
